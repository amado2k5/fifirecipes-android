<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Not touch-only: keyboard/mouse devices (ChromeOS, desktop mode) are
         fully supported, so don't filter them out of Play. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".FifiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fifi"
        tools:targetApi="37">

        <!-- Resizable (default for targetSdk 24+), all orientations, no aspect
             ratio cap: phones, foldables, tablets, ChromeOS windows. Compose
             handles size/density/keyboard changes without recreation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fifi.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links — verified by https://fifi.cooking/.well-known/assetlinks.json
                 (generated by the fifirecipes repo). Same paths the iOS AASA file claims. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="fifi.cooking" />
                <data android:pathPrefix="/recipe/" />
                <data android:pathPrefix="/chapter/" />
                <data android:pathPrefix="/kids/" />
            </intent-filter>
        </activity>
    </application>
</manifest>

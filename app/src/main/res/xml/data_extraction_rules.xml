<?xml version="1.0" encoding="utf-8"?>
<!-- Only the language preference is worth backing up; HTTP/image caches are not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="fifi.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="fifi.xml" />
    </device-transfer>
</data-extraction-rules>
